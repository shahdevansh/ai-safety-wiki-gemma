+def chat_lines(passages):
+    """Give original lines local selection IDs; retain exact text and provenance."""
+    records, lookup = [], {}
+    for p in passages:
+        lines = []
+        for offset, text in enumerate(p['text'].splitlines()):
+            line_id = None
+            if len(text.strip()) >= 8 and not text.lstrip().startswith(('#', '[')):
+                line_id = f'L{len(lookup)+1:03d}'
+                lookup[line_id] = {'source_id':p['id'], 'quote':text,
+                                   'path':p['path'], 'line_number':p['line_start']+offset}
+            lines.append({'line_id':line_id, 'text':text})
+        records.append({'source_id':p['id'], 'path':p['path'], 'lines':lines})
+    return records, lookup
+
+
+def resolve_chat_lines(parsed, lookup):
+    """Resolve selected lines, never invent or normalize a model-written quote."""
+    if not isinstance(parsed, dict) or not isinstance(parsed.get('claims'), list):
+        return parsed
+    claims = []
+    for claim in parsed['claims']:
+        if not isinstance(claim, dict):
+            claims.append(claim); continue
+        supports = []
+        for support in claim.get('supports', []) or []:
+            line = lookup.get(support.get('line_id')) if isinstance(support, dict) else None
+            supports.append({'source_id':line['source_id'], 'quote':line['quote']} if line else
+                            {'source_id':'UNKNOWN_LINE', 'quote':''})
+        claims.append({**claim, 'supports':supports})
+    return {**parsed, 'claims':claims}
+
